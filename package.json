{
  "name": "@react-native-ohos/react-native-xlog",
  "version": "0.5.1-beta.1",
  "description": "Wecha's Xlog framework for react-native",
  "main": "index.js",
  "scripts": {
    "test": "jest"
  },
  "jest": {
    "verbose": true,
    "bail": true,
    "scriptPreprocessor": "node_modules/babel-jest",
    "setupEnvScriptFile": "jestSupport/mockStorage.js"
  },
  "files": [
    "harmony",
    "index.js",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git@github.com:EngsShi/react-native-xlog.git"
  },
  "keywords": [
    "xlog",
    "mars",
    "react-native"
  ],
  "author": "EngsSH <sh9701403@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/EngsShi/react-native-xlog"
  },
  "homepage": "https://github.com/EngsShi/react-native-xlog",
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "devDependencies": {
    "babel-jest": "^5.3.0",
    "jest-cli": "^0.8.0",
    "react-native-harmony-cli": "npm:@react-native-oh/react-native-harmony-cli@^0.0.27",
    "@react-native-community/cli": "11.4.1"
  },
  "harmony": {
    "alias": "react-native-xlog",
    "autolinking": {
      "cppPackageClassName": "RNXLogPackage",
      "cmakeLibraryTargetName": "rnoh_xlog",
      "ohPackageName": "@react-native-ohos/react-native-xlog",
      "etsPackageClassName": "RNXLogPackage"
    }
  }
}
